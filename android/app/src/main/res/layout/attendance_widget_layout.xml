<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attendance_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- EMPTY STATE: Shown when no subjects exist -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/attendance_widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="#E6003830"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/attendance_widget_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Subjects"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/attendance_widget_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/attendance_widget_empty_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add subjects to track attendance"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="#40888888"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- CONTENT STATE: Shows subject attendance data -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/attendance_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="#E6003830"
        android:gravity="center_vertical"
        android:visibility="visible">

        <!-- Left: Circular Progress Ring -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="12dp">

            <!-- Green Ring (≥75%) -->
            <ProgressBar
                android:id="@+id/attendance_widget_progress_green"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_circular_progress_green"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Orange Ring (60-74%) -->
            <ProgressBar
                android:id="@+id/attendance_widget_progress_orange"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_circular_progress_orange"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Red Ring (<60%) -->
            <ProgressBar
                android:id="@+id/attendance_widget_progress_red"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_circular_progress_red"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Percentage Text -->
            <TextView
                android:id="@+id/attendance_widget_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Right: Subject Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical">

            <!-- Subject Name with Color Dot -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/attendance_widget_subject_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#4CAF50"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/attendance_widget_subject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subject"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Ratio -->
            <TextView
                android:id="@+id/attendance_widget_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />

            <!-- P/A/L/E Mini Chips -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/chip_present"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P:0"
                    android:textSize="10sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="#154CAF50" />

                <TextView
                    android:id="@+id/chip_absent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="A:0"
                    android:textSize="10sp"
                    android:textColor="#F44336"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="#15F44336" />

                <TextView
                    android:id="@+id/chip_late"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="L:0"
                    android:textSize="10sp"
                    android:textColor="#FF9800"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="#15FF9800" />

                <TextView
                    android:id="@+id/chip_excused"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="E:0"
                    android:textSize="10sp"
                    android:textColor="#2196F3"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="#152196F3" />
            </LinearLayout>

            <!-- Status Pill -->
            <TextView
                android:id="@+id/attendance_widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add subjects to track attendance"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="#40888888"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Streak Chip -->
            <LinearLayout
                android:id="@+id/attendance_widget_streak_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="#20FFA726"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/attendance_widget_streak_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="0"
                    android:textSize="11sp"
                    android:textColor="#FFA726"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
