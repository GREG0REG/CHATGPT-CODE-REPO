                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="L:0"
                        android:textSize="10sp"
                        android:textColor="#FF9800"
                        android:textStyle="bold"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
