<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Attendance Widget — NEET Edition v3
  Dark green card design matching Reading Tracker widget
  SAFE for RemoteViews: uses only setTextViewText, setTextColor, setViewVisibility
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attendance_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/attendance_widget_bg">

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/attendance_widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/attendance_widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attendance"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/attendance_widget_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to track"
            android:textColor="#B0FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- CONTENT STATE -->
    <LinearLayout
        android:id="@+id/attendance_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="visible">

        <!-- Header: Title + Streak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📊 Attendance"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/attendance_widget_streak_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="#30FFA726"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/attendance_widget_streak_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="0"
                    android:textSize="11sp"
                    android:textColor="#FFA726"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Subject Row 1 (Primary — most at risk) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <!-- Left colored border -->
            <TextView
                android:id="@+id/attendance_widget_subject_dot"
                android:layout_width="4dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:text=""
                android:background="#4CAF50" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/attendance_widget_subject"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Subject"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/attendance_widget_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#4CAF50"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/attendance_widget_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 0"
                    android:textColor="#B0FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- P/A/L/E Chips -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/chip_present"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P:0"
                android:textSize="10sp"
                android:textColor="#81C784"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="#1581C784" />

            <TextView
                android:id="@+id/chip_absent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="A:0"
                android:textSize="10sp"
                android:textColor="#E57373"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="#15E57373" />

            <TextView
                android:id="@+id/chip_late"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="L:0"
                android:textSize="10sp"
                android:textColor="#FFB74D"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="#15FFB74D" />

            <TextView
                android:id="@+id/chip_excused"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="E:0"
                android:textSize="10sp"
                android:textColor="#64B5F6"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="#1564B5F6" />
        </LinearLayout>

        <!-- Status Pill -->
        <TextView
            android:id="@+id/attendance_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add subjects to track attendance"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginStart="14dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:background="#40888888"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
</FrameLayout>
