                    android:textColor="#4CAF50"
                    android:textSize="9sp"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/a3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A:0"
                    android:textColor="#F44336"
                    android:textSize="9sp"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/l3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="L:0"
                    android:textColor="#FF9800"
                    android:textSize="9sp"
