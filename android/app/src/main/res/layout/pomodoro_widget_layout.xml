<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pomodoro_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF6B6B"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pomodoro_widget_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready to Focus"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:alpha="0.95"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/pomodoro_widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to start"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.02"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/pomodoro_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:alpha="0.7"
            android:layout_marginTop="2dp" />

        <ProgressBar
            android:id="@+id/pomodoro_progress_ring"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:progressDrawable="@drawable/widget_progress_drawable"
            android:max="100"
            android:progress="45" />

        <LinearLayout
            android:id="@+id/pomodoro_session_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/completed_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 0"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:alpha="0.8" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
