<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Attendance Widget — NEET Edition v4
  Multi-subject dark green card matching Reading Tracker
  Shows up to 3 subjects stacked vertically, compact layout
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attendance_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/attendance_widget_bg">

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/attendance_widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/attendance_widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attendance"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/attendance_widget_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to add subjects"
            android:textColor="#B0FFFFFF"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- CONTENT STATE -->
    <LinearLayout
        android:id="@+id/attendance_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <!-- Header: Title + Streak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📊 Attendance"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/attendance_widget_streak_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:background="#30FFA726"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/attendance_widget_streak_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="0"
                    android:textSize="10sp"
                    android:textColor="#FFA726"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- === SUBJECT 1 === -->
        <LinearLayout
            android:id="@+id/subject_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/dot_0"
                android:layout_width="3dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="#4CAF50" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/name_0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Botany"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/pct_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#81C784"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ratio_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 / 1 sessions"
                    android:textColor="#B0FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chips row 1 -->
        <LinearLayout
            android:id="@+id/chips_row_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp"
            android:layout_marginStart="11dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/p0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P:1"
                android:textSize="9sp"
                android:textColor="#81C784"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#1581C784" />

            <TextView
                android:id="@+id/a0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="A:0"
                android:textSize="9sp"
                android:textColor="#E57373"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#15E57373" />

            <TextView
                android:id="@+id/l0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="L:0"
                android:textSize="9sp"
                android:textColor="#FFB74D"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#15FFB74D" />

            <TextView
                android:id="@+id/e0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="E:0"
                android:textSize="9sp"
                android:textColor="#64B5F6"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#1564B5F6" />
        </LinearLayout>

        <!-- Status 1 -->
        <TextView
            android:id="@+id/status_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Can miss 0 more sessions"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginStart="11dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="#40888888"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Divider -->
        <View
            android:id="@+id/divider_0"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:background="#20FFFFFF"
            android:visibility="gone" />

        <!-- === SUBJECT 2 === -->
        <LinearLayout
            android:id="@+id/subject_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/dot_1"
                android:layout_width="3dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="#4ECDC4" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/name_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chemistry"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/pct_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#81C784"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ratio_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 / 1 sessions"
                    android:textColor="#B0FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chips row 2 -->
        <LinearLayout
            android:id="@+id/chips_row_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp"
            android:layout_marginStart="11dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/p1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P:1"
                android:textSize="9sp"
                android:textColor="#81C784"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#1581C784" />

            <TextView
                android:id="@+id/a1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="A:0"
                android:textSize="9sp"
                android:textColor="#E57373"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#15E57373" />

            <TextView
                android:id="@+id/l1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="L:0"
                android:textSize="9sp"
                android:textColor="#FFB74D"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#15FFB74D" />

            <TextView
                android:id="@+id/e1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="E:0"
                android:textSize="9sp"
                android:textColor="#64B5F6"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#1564B5F6" />
        </LinearLayout>

        <!-- Status 2 -->
        <TextView
            android:id="@+id/status_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Can miss 0 more sessions"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginStart="11dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="#40888888"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Divider -->
        <View
            android:id="@+id/divider_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:background="#20FFFFFF"
            android:visibility="gone" />

        <!-- === SUBJECT 3 === -->
        <LinearLayout
            android:id="@+id/subject_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/dot_2"
                android:layout_width="3dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="#FF6B6B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/name_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Physics"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/pct_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#81C784"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ratio_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 / 1 sessions"
                    android:textColor="#B0FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chips row 3 -->
        <LinearLayout
            android:id="@+id/chips_row_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp"
            android:layout_marginStart="11dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/p2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P:1"
                android:textSize="9sp"
                android:textColor="#81C784"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#1581C784" />

            <TextView
                android:id="@+id/a2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="A:0"
                android:textSize="9sp"
                android:textColor="#E57373"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#15E57373" />

            <TextView
                android:id="@+id/l2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="L:0"
                android:textSize="9sp"
                android:textColor="#FFB74D"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#15FFB74D" />

            <TextView
                android:id="@+id/e2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="E:0"
                android:textSize="9sp"
                android:textColor="#64B5F6"
                android:textStyle="bold"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:background="#1564B5F6" />
        </LinearLayout>

        <!-- Status 3 -->
        <TextView
            android:id="@+id/status_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Can miss 0 more sessions"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginStart="11dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="#40888888"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
