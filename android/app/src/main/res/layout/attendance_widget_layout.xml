<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attendance_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/attendance_widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="#E6003830"
        android:gravity="center_vertical"
        android:visibility="gone">
        <!-- ... same as before ... -->
    </LinearLayout>

    <!-- CONTENT STATE -->
    <LinearLayout
        android:id="@+id/attendance_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#E6003830">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
            <!-- ... same header ... -->
        </LinearLayout>

        <!-- ===== SUBJECT 0 — MUST HAVE THIS ID ===== -->
        <LinearLayout
            android:id="@+id/subject_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ... all the original subject 0 views ... -->

        </LinearLayout>

        <View
            android:id="@+id/divider_0"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:background="#20FFFFFF"
            android:visibility="gone" />

        <!-- Subject 1, 2, 3 ... same as before -->

    </LinearLayout>
</FrameLayout>
