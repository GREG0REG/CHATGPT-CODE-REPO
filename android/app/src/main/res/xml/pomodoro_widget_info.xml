<?xml version="1.0" encoding="utf-8"?>
<!-- 
  NEET Edition Pomodoro Widget Configuration
  - 4x2 cells default for circular progress visibility
  - Resizable horizontal + vertical
  - 0 updatePeriodMillis (manual alarm-based updates for accuracy)
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="120dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="100dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/pomodoro_widget_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/pomodoro_widget_description"
    android:previewImage="@drawable/widget_background_fallback">
</appwidget-provider>
