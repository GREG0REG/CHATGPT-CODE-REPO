                    <TextView
                        android:id="@+id/e3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="E:0"
                        android:textSize="9sp"
                        android:textColor="#2196F3"
